# Calmly — environment variables

Copy this file to `.env` and fill in real values. 

# --- required ---
MONGODB_URL=mongodb+srv://user:password@cluster/CalmlyWebdb
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- plant / exercise images ---
# (none)

# --- Cloudinary (avatar + document uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI providers (quiz personalization + weekly reports) ---
GEMINI_API_KEY=
GROQ_API_KEY=
#  keys used for Journal score
GEMINI_API_KEY_2=
GROQ_API_KEY_2=

# --- cron job auth (weekly report generation) ---
CRON_SECRET=change-me

# --- email (OTP verification + password reset) ---
# When these are empty, Calmly logs emails to the server console
# (dev fallback) instead of sending them.
SMTP_HOST=SMTP_HOST
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# set to "true" for port 465 (implicit TLS); otherwise STARTTLS is used
SMTP_SECURE=
EMAIL_FROM=
